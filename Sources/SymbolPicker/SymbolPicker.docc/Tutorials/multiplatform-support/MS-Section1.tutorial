@Tutorial(time: 15) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Optimizing for macOS Compatibility") {
        This section guides you through adapting the Checker app for seamless compilation and functionality on macOS, ensuring a cohesive user experience across platforms.
        @Image(source: MS-Banner, alt: "Checker app interface displayed on a Mac desktop, showcasing event management features.")
    }
    
    @Section(title: "Switching the App Target to macOS") {
        @ContentAndMedia {
            Configure your Xcode project to target macOS, laying the groundwork for robust multiplatform support.
            
            @Image(source: MS-Section1.png, alt: "Side-by-side view of the Checker app on an iPhone and a Mac, highlighting a consistent interface with event lists and SF Symbols.")
        }

        @Steps {
            @Step {
                In the Xcode top bar, locate and select the current target device, such as "iPhone 16", from the device selection menu.
                @Image(source: MS-Section1-Step1.png, alt: "Xcode interface with the device selection menu highlighted in the top bar, showing 'iPhone 16' as the current target.")
            }
            @Step {
                From the device menu, select "My Mac" to switch the build target to macOS.
                @Image(source: MS-Section1-Step2.png, alt: "Xcode interface with the device menu open, highlighting the 'My Mac' option for macOS compilation.")
            }
            @Step {
                Compile the app; it may fail due to unsupported SwiftUI modifiers, which will be addressed in the following sections.
                @Image(source: MS-Section1-Step3.png, alt: "Xcode error output showing compilation failures due to unsupported modifiers on macOS.")
            }
        }
    }
    
    @Section(title: "Excluding Unsupported Modifiers for macOS") {
        @ContentAndMedia {
            Adjust SwiftUI code to conditionally apply modifiers, ensuring compatibility with macOS while maintaining functionality on other platforms.
            
            @Image(source: MS-Section2.png, alt: "Checker app interface on an iPhone and a Mac, showcasing consistent event lists and navigation elements.")
        }

        @Steps {
            @Step {
                In the Xcode project navigator, open the "EventCreateView.swift" file to modify unsupported modifiers.
                @Code(name: "EventCreateView.swift", file: "MS-Section2-Step1.swift") {
                    @Image(source: MS-Section2-Step1.png, alt: "EventCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Enclose the `.navigationBarTitleDisplayMode(.inline)` modifier in an `#if !os(macOS)` `#endif` block to exclude it on macOS.
                @Code(name: "EventCreateView.swift", file: "MS-Section2-Step2.swift") {
                    @Image(source: MS-Section2-Step2.png, alt: "EventCreateView.swift with conditional compilation for navigationBarTitleDisplayMode.")
                }
            }
            @Step {
                Open the "TypeCreateView.swift" file to apply similar conditional modifications.
                @Code(name: "TypeCreateView.swift", file: "MS-Section2-Step3.swift") {
                    @Image(source: MS-Section2-Step3.png, alt: "TypeCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Wrap the `.navigationBarTitleDisplayMode(.inline)` modifier in an `#if !os(macOS)` `#endif` block to ensure macOS compatibility.
                @Code(name: "TypeCreateView.swift", file: "MS-Section2-Step4.swift") {
                    @Image(source: MS-Section2-Step4.png, alt: "TypeCreateView.swift with conditional compilation for navigationBarTitleDisplayMode.")
                }
            }
        }
    }
    
    @Section(title: "Refining the macOS Design") {
        @ContentAndMedia {
            Optimize the app’s window size and behavior for a polished macOS experience.
            
            @Image(source: MS-Section3.png, alt: "Checker app interface on a Mac, highlighting a compact window with consistent event list and navigation elements.")
        }

        @Steps {
            @Step {
                In the Xcode project navigator, open the "CheckerApp.swift" file to adjust the app’s window sizing for macOS.
                @Code(name: "CheckerApp.swift", file: "MS-Section3-Step1.swift") {
                    @Image(source: MS-Section3-Step1.png, alt: "CheckerApp.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Add a `.frame` modifier to `ContentView` with a width of 400 and height of 400, wrapped in an `#if os(macOS)` block to apply it only on macOS.
                @Code(name: "CheckerApp.swift", file: "MS-Section3-Step2.swift") {
                    @Image(source: MS-Section3-Step2.png, alt: "CheckerApp.swift with frame modifier for macOS.")
                }
            }
            @Step {
                Apply a `.windowResizability(.contentSize)` modifier to the `WindowGroup` to restrict window resizing on macOS, ensuring a consistent layout.
                @Code(name: "CheckerApp.swift", file: "MS-Section3-Step3.swift") {
                    @Image(source: MS-Section3-Step3.png, alt: "CheckerApp.swift with window resizability modifier.")
                }
            }
        }
    }
}
