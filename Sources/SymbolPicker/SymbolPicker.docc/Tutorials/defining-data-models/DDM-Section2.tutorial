@Tutorial(time: 12) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Crafting Data Models") {
        This section provides a comprehensive, step-by-step guide to creating effective data models for the Checker project.
        
        @Image(source: DDM-Banner, alt: "SwiftData file icon.")
    }
    
    @Section(title: "Organizing Your File Structure") {
        @ContentAndMedia {
            Establish a clear and organized file hierarchy to improve development efficiency and maintainability.
            
            @Image(source: DDM-Section2.png, alt: "Three orange Swift bird icons arranged vertically, symbolizing the Swift programming language.")
        }
        @Steps {
            @Step {
                Press CMD + N in Xcode to create a new file, then select "Swift File" from the template options.
                @Image(source: DDM-Section2-Step1.png, alt: "Xcode new file dialog with the 'Swift File' option highlighted under the iOS category and the Next button emphasized.")
            }
            
            @Step {
                Name the file "Event" in the Save As field and click Create to generate the new Swift file.
                @Image(source: DDM-Section2-Step2.png, alt: "Xcode file creation dialog with 'Event' entered in the Save As field, the Checker project selected, and the Create button highlighted.")
            }
            
            @Step {
                Create another file named `"Type.swift"` to complement `"Event.swift"`, organizing distinct data models into separate files for clarity.
                @Image(source: DDM-Section2-Step3.png, alt: "Two Swift file icons labeled 'Type.swift' and 'Event.swift' side by side.")
            }
        }
    } 
    
    @Section(title: "Creating the Type Data Model") {
        @ContentAndMedia {
            Build a robust Type model to serve as the foundation for your app’s categorization functionality.
            
            @Image(source: DDM-Section3.png, alt: "Swift file icon labeled 'Type.swift', representing the Type data model.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "Type.swift" file to start defining the data model.
                @Code(name: "Type.swift", file: "DDM-Section3-Step1.swift")
            }
            @Step {
                Import SwiftData and define the `Type` class using the `@Model` macro, ensuring it conforms to `Identifiable` for unique identification, `Equatable` for equality comparisons, `Comparable` for sorting, and `Hashable` for hashing.
                @Code(name: "Type.swift", file: "DDM-Section3-Step2.swift")
            }
            @Step {
                Add `String` properties `title` and `symbolName`, a `UUID` property `id`, and import the `SymbolPicker` framework to include a `SymbolColor` property named `color`.
                @Code(name: "Type.swift", file: "DDM-Section3-Step3.swift")
            }
            @Step {
                Create an initializer for the `Type` class with default values to simplify temporary `Type` creation.
                @Code(name: "Type.swift", file: "DDM-Section3-Step4.swift")
            }
            @Step {
                Implement the `==`, `<`, and hash functions to satisfy the requirements for `Equatable`, `Hashable`, and `Comparable` protocols.
                @Code(name: "Type.swift", file: "DDM-Section3-Step5.swift")
            }
        }
    } 

    @Section(title: "Developing the Event Data Model") {
        @ContentAndMedia {
            Create a comprehensive `Event` model to form the core data structure for your app.
            
            @Image(source: DDM-Section4.png, alt: "Swift file icon labeled 'Event.swift', representing the Event data model.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "Event.swift" file to begin defining the data model.
                @Code(name: "Event.swift", file: "DDM-Section4-Step1.swift")
            }
            @Step {
                Declare the `Event` class, import SwiftData, apply the `@Model` macro, and ensure it conforms to `Identifiable`, `Equatable`, `Comparable`, and `Hashable`.
                @Code(name: "Event.swift", file: "DDM-Section4-Step2.swift")
            }
            @Step {
                Add `id`, `title`, and `description` properties, ensuring the class conforms to `Identifiable` and `Codable` for effective data management.
                @Code(name: "Event.swift", file: "DDM-Section4-Step3.swift")
            }
            @Step {
                Establish a relationship with the `Type` model by adding an optional `type` property.
                @Code(name: "Event.swift", file: "DDM-Section4-Step4.swift")
            }
            @Step {
                Create an initializer for the `Event` class with default values to facilitate temporary `Event` creation.
                @Code(name: "Event.swift", file: "DDM-Section4-Step5.swift")
            }
            @Step {
                Implement the `==`, `<`, and hash functions to meet the requirements for `Equatable`, `Hashable`, and `Comparable` protocols.
                @Code(name: "Event.swift", file: "DDM-Section4-Step6.swift")
            }
        }
    } 
}
