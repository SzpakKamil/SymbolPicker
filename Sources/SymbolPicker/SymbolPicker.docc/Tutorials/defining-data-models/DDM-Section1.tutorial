@Tutorial(time: 5) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Starting a New Project") {
        This section guides you through efficiently setting up a new project with the SymbolPicker Framework.
        
        @Image(source: DDM-Banner, alt: "SwiftData file icon.")
    }
    
    @Section(title: "Configuring a New Project with SearchBar Integration") {
        @ContentAndMedia {
            Set up and configure an Xcode project to seamlessly integrate the SymbolPicker framework.
            
            @Image(source: DDM-Section1.png, alt: "Diagram showing the integration flow from the SymbolPicker framework to the Xcode project.")
        }
        
        @Steps {
            @Step {
                Open Xcode and choose "Create New Project" from the welcome screen or go to File > New > Project in the menu.
                
                @Image(source: DDM-Section1-Step1.png, alt: "Xcode welcome screen with the 'Create New Project' option highlighted among Create New Project, Clone Git Repository, and Open Existing Project.")
            }
            
            @Step {
                In the template chooser, select the Multiplatform platform, choose the App template, and click Next to continue.
                
                @Image(source: DDM-Section1-Step2.png, alt: "Xcode template selection dialog with Multiplatform selected, the App template highlighted, and the Next button emphasized.")
            }
            
            @Step {
                Enter "Checker" as the Product Name, click Next, and choose an appropriate directory on your Mac to save the Checker project.
                
                @Image(source: DDM-Section1-Step3.png, alt: "Xcode project configuration window showing 'Checker' entered as the Product Name.")
            }
            
            @Step {
                In the Checker project, go to File > Add Package Dependencies in the Xcode menu bar to include external libraries.
                
                @Image(source: DDM-Section1-Step4.png, alt: "Xcode menu bar with File > Add Package Dependencies option selected.")
            }
            
            @Step {
                In the package search field, enter the URL `https://github.com/SzpakKamil/SymbolPicker`, set the dependency rule to "Up to Next Major Version", verify the version is 1.0.0 or higher, and click Add Package to proceed.
                
                @Image(source: DDM-Section1-Step5.png, alt: "Xcode package dependency dialog displaying the URL 'https://github.com/SzpakKamil/SymbolPicker', 'Up to Next Major Version' rule, and version 1.0.0 or higher.")
            }
            
            @Step {
                Confirm that the "SymbolPicker" package product is linked to the "Checker" target, then click "Add Package" to complete the integration.
                
                @Image(source: DDM-Section1-Step6.png, alt: "Xcode package products selection window showing 'SymbolPicker' linked to the 'Checker' target.")
            }
        }
    }
}
