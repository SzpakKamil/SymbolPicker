@Tutorial(time: 25) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Crafting the Type Creation Screen") {
        This section guides you through building a type creation screen and linking it to the event creation screen to enable seamless category management in the Checker app.
        
        @Image(source: BAU-Banner, alt: "Type creation interface displayed on a tablet.")
    }
    
    @Section(title: "Designing the Type Creation View") {
        @ContentAndMedia {
            Create an intuitive type creation screen to allow users to define custom categories with SF Symbols.
            
            @Image(source: BAU-Section5.png, alt: "Type creation form interface in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "TypeCreateView.swift" file to begin constructing the type creation interface.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step1.swift") {
                    @Image(source: BAU-Section5-Step1.png, alt: "TypeCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Define an `@State` property named `type` to manage form inputs and wrap the view’s body in a `NavigationStack` for seamless navigation.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step2.swift") {
                    @Image(source: BAU-Section5-Step2.png, alt: "NavigationStack setup in TypeCreateView.swift.")
                }
            }
            @Step {
                Add a `Form` inside the `NavigationStack`, applying `navigationTitle("Add Type")` and `navigationBarTitleDisplayMode(.inline)` modifiers for a polished header.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step3.swift") {
                    @Image(source: BAU-Section5-Step3.png, alt: "Form with navigation title in TypeCreateView.swift.")
                }
            }
            @Step {
                Add a `TextField` for the type title, bound to `$type.title`, to capture the category name.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step4.swift") {
                    @Image(source: BAU-Section5-Step4.png, alt: "TextField component in the type creation form.")
                }
            }
            @Step {
                Import the `SymbolPicker` package and add an `@State` property named `isPresentingSymbolPicker` with a default value of `false` to control SymbolPicker presentation.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step5.swift") {
                    @Image(source: BAU-Section5-Step5.png, alt: "SymbolPicker state setup in TypeCreateView.swift.")
                }
            }
            @Step {
                Below the `TextField`, add a `Button` titled "Select Symbol" with the system image `type.symbolName`, setting its action to `isPresentingSymbolPicker.toggle()` and applying `.buttonStyle(.plain)` and `.foregroundStyle(type.symbolColor.color)` modifiers.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step6.swift") {
                    @Image(source: BAU-Section5-Step6.png, alt: "Select Symbol button in the type creation form.")
                }
            }
            @Step {
                Add a `.symbolPicker` modifier to the `Button`, binding `isPresented` to `$isPresentingSymbolPicker`, `symbolName` to `$type.symbolName`, and `color` to `$type.symbolColor`, followed by a `.symbolPickerStyle(.outlined)` modifier for an outlined style.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section5-Step7.swift") {
                    @Image(source: BAU-Section5-Step7.png, alt: "SymbolPicker modifier with outlined style in TypeCreateView.swift.")
                }
            }
        }
    }
    
    @Section(title: "Enhancing the Event Creation Screen") {
        @ContentAndMedia {
            Add a type picker to the event creation screen to enable category selection and integrate a modal sheet for the type creation view.
            
            @Image(source: BAU-Section6.png, alt: "Event creation form with type picker in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "EventCreateView.swift" file to add the type picker and related logic.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step1.swift") {
                    @Image(source: BAU-Section6-Step1.png, alt: "EventCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Add an `@State` property named `isPresentingTypeSheet` with a default value of `false` to control the presentation of the type creation sheet.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step2.swift") {
                    @Image(source: BAU-Section6-Step2.png, alt: "isPresentingTypeSheet state in EventCreateView.swift.")
                }
            }
            @Step {
                Below the `TextField` components, add a `Menu` titled "Type: \(event.type?.title ?? "None")" with the system image `event.type?.symbolName ?? "archivebox"`.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step3.swift") {
                    @Image(source: BAU-Section6-Step3.png, alt: "Type menu in the event creation form.")
                }
            }
            @Step {
                Inside the `Menu`, add a `Button` titled "Add Type" with the system image "plus.circle" and an action to toggle `isPresentingTypeSheet`.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step4.swift") {
                    @Image(source: BAU-Section6-Step4.png, alt: "Add Type button in the type menu.")
                }
            }
            @Step {
                Add an `@Query` property named `types` of type `[Type]` to fetch available type categories.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step5.swift") {
                    @Image(source: BAU-Section6-Step5.png, alt: "Types query in EventCreateView.swift.")
                }
            }
            @Step {
                Inside the `Menu`, add a `Divider` followed by an `if` block checking `!types.isEmpty`, with an else block containing a `Text` view displaying "No Types Found".
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step6.swift") {
                    @Image(source: BAU-Section6-Step6.png, alt: "Type menu with no types found message.")
                }
            }
            @Step {
                Inside the `if` block, add a `Picker` titled "Types" with the selection bound to `$event.type`.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step7.swift") {
                    @Image(source: BAU-Section6-Step7.png, alt: "Type picker in the event creation form.")
                }
            }
            @Step {
                Inside the `Picker`, add a `ForEach` loop over the `types` array, creating a `Label` for each type with `type.title` as the title and `type.symbolName` as the system image.
                @Code(name: "EventCreateView.swift", file: "BAU-Section6-Step8.swift") {
                    @Image(source: BAU-Section6-Step8.png, alt: "Type picker with labeled options in the event creation form.")
                }
            }
        }
    }
    
    @Section(title: "Adding Actions to the Type Creation Screen") {
        @ContentAndMedia {
            Implement save and dismiss actions for the type creation screen to persist categories and update event relationships.
            
            @Image(source: BAU-Section7.png, alt: "Type creation form with toolbar actions in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "TypeCreateView.swift" file and import `SwiftData` to add toolbar actions.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step1.swift") {
                    @Image(source: BAU-Section7-Step1.png, alt: "TypeCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Add an optional `@Binding` property named `parentType` to update the event’s type, along with `@Environment(\.dismiss)` named `dismiss` and `@Environment(\.modelContext)` named `modelContext`.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step2.swift") {
                    @Image(source: BAU-Section7-Step2.png, alt: "Binding and environment properties in TypeCreateView.swift.")
                }
            }
            @Step {
                Apply a `.toolbar` modifier to the `Form`, adding two `ToolbarItem` instances with `.cancellationAction` and `.primaryAction` placements.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step3.swift") {
                    @Image(source: BAU-Section7-Step3.png, alt: "Toolbar setup in TypeCreateView.swift.")
                }
            }
            @Step {
                For the `.cancellationAction`, add a `Button` titled "Close" with the system image "xmark" and an action to call `dismiss()`.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step4.swift") {
                    @Image(source: BAU-Section7-Step4.png, alt: "Close button in the type creation toolbar.")
                }
            }
            @Step {
                For the `.primaryAction`, add a `Button` titled "Add Type" with the system image "checkmark", triggering `modelContext.insert(type)`, `parentType = type`, and `dismiss()`.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step5.swift") {
                    @Image(source: BAU-Section7-Step5.png, alt: "Add Type button in the type creation toolbar.")
                }
            }
            @Step {
                Add a `.disabled(type.isInvalid)` modifier to the `.primaryAction` button to prevent submission of invalid types.
                @Code(name: "TypeCreateView.swift", file: "BAU-Section7-Step6.swift") {
                    @Image(source: BAU-Section7-Step6.png, alt: "Disabled Add Type button for validation in TypeCreateView.swift.")
                }
            }
        }
    }
    
    @Section(title: "Connecting TypeCreateView via Modal Sheet") {
        @ContentAndMedia {
            Link the event creation screen to the type creation view using a modal sheet for seamless category creation.
            
            @Image(source: BAU-Section8.png, alt: "Modal sheet for TypeCreateView in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "EventCreateView.swift" file to integrate the modal sheet for TypeCreateView.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step1.swift") {
                    @Image(source: BAU-Section8-Step1.png, alt: "EventCreateView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Add a `.sheet` modifier to the `Form`, binding it to `$isPresentingTypeSheet` with `TypeCreateView(parentType: $event.type)` as the content.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step2.swift") {
                    @Image(source: BAU-Section8-Step2.png, alt: "Sheet modifier for TypeCreateView in EventCreateView.swift.")
                }
            }
            @Step {
                Below the `TypeCreateView` in the sheet, add a `.presentationDetents([.medium])` modifier for a compact modal appearance.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step3.swift") {
                    @Image(source: BAU-Section8-Step3.png, alt: "Compact modal sheet for TypeCreateView.")
                }
            }
            @Step {
                Add an `@State` property named `hasAddedEvent` with a default value of `false` to manage relationship auto-insertion logic.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step4.swift") {
                    @Image(source: BAU-Section8-Step4.png, alt: "hasAddedEvent state in EventCreateView.swift.")
                }
            }
            @Step {
                Add an `.onDisappear` modifier to the `Form`, calling `modelContext.delete(event)` if `hasAddedEvent` is `false` to clean up unsaved events.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step5.swift") {
                    @Image(source: BAU-Section8-Step5.png, alt: "onDisappear modifier in EventCreateView.swift.")
                }
            }
            @Step {
                Update the `.primaryAction` toolbar button’s action to set `hasAddedEvent = true` before calling `dismiss()` to confirm event persistence.
                @Code(name: "EventCreateView.swift", file: "BAU-Section8-Step6.swift") {
                    @Image(source: BAU-Section8-Step6.png, alt: "Updated Add Event button action in EventCreateView.swift.")
                }
            }
        }
    }
}
