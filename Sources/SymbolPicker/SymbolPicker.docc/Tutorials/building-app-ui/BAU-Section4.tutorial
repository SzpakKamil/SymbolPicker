@Tutorial(time: 10) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Creating the Event Details Screen") {
        This section guides you through building a detailed event view for the Checker app, enabling users to view and manage event information effectively.
        
        @Image(source: BAU-Banner, alt: "Event details interface displayed on a tablet in the Checker app.")
    }
    
    @Section(title: "Configuring Required Properties") {
        @ContentAndMedia {
            Set up essential properties to support the event details screen’s functionality and data management.
            
            @Image(source: BAU-Section12.png, alt: "Event details view properties in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "EventDetailsView.swift" file to begin adding necessary properties.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section12-Step1.swift") {
                    @Image(source: BAU-Section12-Step1.png, alt: "EventDetailsView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Import `SymbolPicker`, add a `selectedEvent` property, and update the app preview to pass an example `selectedEvent` for testing.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section12-Step2.swift") {
                    @Image(source: BAU-Section12-Step2.png, alt: "selectedEvent property in EventDetailsView.swift.")
                }
            }
            @Step {
                Add an `@Environment(\.dismiss)` property named `dismiss` to handle modal sheet dismissal.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section12-Step3.swift") {
                    @Image(source: BAU-Section12-Step3.png, alt: "Dismiss environment property in EventDetailsView.swift.")
                }
            }
            @Step {
                Import `SwiftData` and add an `@Environment(\.modelContext)` property named `modelContext` to enable deletion of the `selectedEvent`.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section12-Step4.swift") {
                    @Image(source: BAU-Section12-Step4.png, alt: "Model context setup in EventDetailsView.swift.")
                }
            }
        }
    }
    
    @Section(title: "Building the Event Details UI") {
        @ContentAndMedia {
            Construct the event details screen using the configured properties for a clear and interactive user interface.
            
            @Image(source: BAU-Section13.png, alt: "Event details interface in the Checker app.")
        }
        
        @Steps {
            @Step {
                Replace the view’s content with a `NavigationStack` containing a `List`, applying a `.navigationTitle(selectedEvent.title)` modifier to display the event’s title.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step1-After.swift", previousFile: "BAU-Section13-Step1-Before.swift") {
                    @Image(source: BAU-Section13-Step1.png, alt: "NavigationStack and List setup in EventDetailsView.swift.")
                }
            }
            @Step {
                Inside the `List`, add a `Section` titled "Details" containing a `Text` view that displays `selectedEvent.details` or "No Details Provided" if `selectedEvent.details.isEmpty`.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step2.swift") {
                    @Image(source: BAU-Section13-Step2.png, alt: "Details section in EventDetailsView.swift.")
                }
            }
            @Step {
                Next to the details `Text`, add a `Label` with the title "Type: \(selectedEvent.type?.title ?? "None")" and system image `selectedEvent.type?.symbolName ?? "archivebox"`.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step3.swift") {
                    @Image(source: BAU-Section13-Step3.png, alt: "Type label in EventDetailsView.swift.")
                }
            }
            @Step {
                Add a new `Section` titled "Actions" to house action-related controls.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step4.swift") {
                    @Image(source: BAU-Section13-Step4.png, alt: "Actions section in EventDetailsView.swift.")
                }
            }
            @Step {
                Inside the "Actions" section, add a `Button` titled "Delete" with the system image "trash", role `.destructive`, and action `modelContext.delete(selectedEvent)`, styled with `.foregroundStyle(.red)`.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step5.swift") {
                    @Image(source: BAU-Section13-Step5.png, alt: "Delete button in EventDetailsView.swift.")
                }
            }
            @Step {
                Apply a `.toolbar` modifier to the `List`, adding a single `ToolbarItem` with `.cancellationAction` placement.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step6.swift") {
                    @Image(source: BAU-Section13-Step6.png, alt: "Toolbar setup in EventDetailsView.swift.")
                }
            }
            @Step {
                Inside the `ToolbarItem`, add a `Button` titled "Close" with the system image "xmark" and action `dismiss()`.
                @Code(name: "EventDetailsView.swift", file: "BAU-Section13-Step7.swift") {
                    @Image(source: BAU-Section13-Step7.png, alt: "Close button in EventDetailsView.swift toolbar.")
                }
            }
        }
    }
    
    @Section(title: "Connecting to the Main App UI") {
        @ContentAndMedia {
            Link the event details screen to the main app interface for seamless navigation.
            
            @Image(source: BAU-Section14.png, alt: "Event details integration with main app UI in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "ContentView.swift" file to integrate the event details screen.
                @Code(name: "ContentView.swift", file: "BAU-Section14-Step1.swift") {
                    @Image(source: BAU-Section14-Step1.png, alt: "ContentView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Below the existing `.sheet` modifier, add a second `.sheet` modifier with the `item` binding set to `$selectedEvent` and content set to `EventDetailsView(selectedEvent: $0)`.
                @Code(name: "ContentView.swift", file: "BAU-Section14-Step2.swift") {
                    @Image(source: BAU-Section14-Step2.png, alt: "Event details sheet in ContentView.swift.")
                }
            }
            @Step {
                Update the `row` function to wrap its content in a `Button` with the action `selectedEvent = event`, using the current row implementation as the label and applying `.buttonStyle(.plain)` for styling.
                @Code(name: "ContentView.swift", file: "BAU-Section14-Step3-After.swift", previousFile: "BAU-Section14-Step3-Before.swift") {
                    @Image(source: BAU-Section14-Step3.png, alt: "Button-wrapped row in ContentView.swift.")
                }
            }
        }
    }
}
