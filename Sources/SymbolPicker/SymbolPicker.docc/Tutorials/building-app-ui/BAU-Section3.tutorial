@Tutorial(time: 30) {
    @XcodeRequirement(
           title: "Xcode 15 or later", 
           destination: "https://developer.apple.com/download/")

    @Intro(title: "Building the Main App List UI") {
        This section guides you through creating the main user interface for the Checker app, displaying events in an organized list with seamless navigation and interaction.
        
        @Image(source: BAU-Banner, alt: "Checker app main interface displayed on a tablet.")
    }
    
    @Section(title: "Setting Up View Properties") {
        @ContentAndMedia {
            Configure essential imports and properties to support the construction of the app’s main UI.
            
            @Image(source: BAU-Section9.png, alt: "Main app interface properties in the Checker app.")
        }
        
        @Steps {
            @Step {
                In the Xcode project navigator, open the "ContentView.swift" file and import `SwiftData` to enable event data fetching.
                @Code(name: "ContentView.swift", file: "BAU-Section9-Step1-After.swift", previousFile: "BAU-Section9-Step1-Before.swift") {
                    @Image(source: BAU-Section9-Step1.png, alt: "ContentView.swift file open in the Xcode editor.")
                }
            }
            @Step {
                Add an `@Query` property named `events` of type `[Event]` to fetch all stored events, and an `@State` property named `isPresentingEventCreateScreen` with a default value of `false` for modal presentation.
                @Code(name: "ContentView.swift", file: "BAU-Section9-Step2.swift") {
                    @Image(source: BAU-Section9-Step2.png, alt: "Event query and state setup in ContentView.swift.")
                }
            }
            @Step {
                Add an `@Environment(\.modelContext)` property named `modelContext` to enable deletion of records later.
                @Code(name: "ContentView.swift", file: "BAU-Section9-Step3.swift") {
                    @Image(source: BAU-Section9-Step3.png, alt: "Model context setup in ContentView.swift.")
                }
            }
            @Step {
                Add an optional `@State` property named `selectedEvent` of type `Event?` to track the currently selected event.
                @Code(name: "ContentView.swift", file: "BAU-Section9-Step4.swift") {
                    @Image(source: BAU-Section9-Step4.png, alt: "Selected event state in ContentView.swift.")
                }
            }
            @Step {
                Add an `@Query` property named `types` of type `[Type]` to fetch all available types for accessing their associated symbols.
                @Code(name: "ContentView.swift", file: "BAU-Section9-Step5.swift") {
                    @Image(source: BAU-Section9-Step5.png, alt: "Types query setup in ContentView.swift.")
                }
            }
        }
    }
    
    @Section(title: "Constructing the ContentView UI") {
        @ContentAndMedia {
            Build the main app interface with a dynamic list to display events grouped by type.
            
            @Image(source: BAU-Section10.png, alt: "Main app list interface in the Checker app.")
        }
        
        @Steps {
            @Step {
                Inside the `body`, add a `Group` wrapped in a `NavigationStack` to structure the main UI.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step1.swift") {
                    @Image(source: BAU-Section10-Step1.png, alt: "NavigationStack setup in ContentView.swift.")
                }
            }
            @Step {
                Apply a `.navigationTitle("Checker")` modifier to the `Group` for a clear app title.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step2.swift") {
                    @Image(source: BAU-Section10-Step2.png, alt: "Navigation title in ContentView.swift.")
                }
            }
            @Step {
                Inside the `Group`, add an `if events.isEmpty` block and an else block containing a `List` to handle empty and populated states.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step3.swift") {
                    @Image(source: BAU-Section10-Step3.png, alt: "Conditional list setup in ContentView.swift.")
                }
            }
            @Step {
                In the `if` block, add a `ContentUnavailableView` with the title "No Events", system image "plus.circle", and a description `Text("Create events to display them here.")`, applying the `.ignoresSafeArea()` modifier for perfect centering.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step4.swift") {
                    @Image(source: BAU-Section10-Step4.png, alt: "ContentUnavailableView for empty state in ContentView.swift.")
                }
            }
            @Step {
                In the else block, add a `groupedEvents` constant, a `Dictionary` grouping `events` by their type’s title, defaulting to "Not Specified" for untyped events.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step5.swift") {
                    @Image(source: BAU-Section10-Step5.png, alt: "Grouped events dictionary in ContentView.swift.")
                }
            }
            @Step {
                Inside the `List`, add a `ForEach` over `groupedEvents.sorted { $0.key < $1.key }`, using `\.key` as the `id`, with each iteration variable named `pair`.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step6.swift") {
                    @Image(source: BAU-Section10-Step6.png, alt: "ForEach loop over grouped events in ContentView.swift.")
                }
            }
            @Step {
                Inside the `ForEach`, add a `Section` with a header containing a `systemImage` constant set to `types.first { $0.title == pair.key }?.symbolName ?? "archivebox"`, and a `Label` with `pair.key` as the title and `systemImage` as the system image.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step7.swift") {
                    @Image(source: BAU-Section10-Step7.png, alt: "Section header with symbol in ContentView.swift.")
                }
            }
            @Step {
                Inside the `Section` body, add a `ForEach` over `pair.value`, accessing each `event` to display associated events.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step8.swift") {
                    @Image(source: BAU-Section10-Step8.png, alt: "Event list in section body in ContentView.swift.")
                }
            }
            @Step {
                Create a `@ViewBuilder` function named `row` that accepts an `event` parameter and returns a `View` for consistent row styling.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step9.swift") {
                    @Image(source: BAU-Section10-Step9.png, alt: "Row view builder function in ContentView.swift.")
                }
            }
            @Step {
                Import `SymbolPicker` and, inside the `row` function, add an `HStack` containing an `Image` with `systemName` set to `event.symbolName`, styled with `.imageScale(.large)` and `.foregroundStyle(event.symbolColor.color)`.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step10.swift") {
                    @Image(source: BAU-Section10-Step10.png, alt: "Symbol image in row view in ContentView.swift.")
                }
            }
            @Step {
                Below the `Image`, add a `VStack` aligned to `.leading`, containing a `Text(event.title)` with `.headline` font, and, if `!event.details.isEmpty`, a `Text(event.details)` with `.callout` font, both using `.multilineTextAlignment(.leading)`.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step11.swift") {
                    @Image(source: BAU-Section10-Step11.png, alt: "Text components in row view in ContentView.swift.")
                }
            }
            @Step {
                Inside the `pair.value` `ForEach`, call the `row(for: event)` function to render each event row.
                @Code(name: "ContentView.swift", file: "BAU-Section10-Step12.swift") {
                    @Image(source: BAU-Section10-Step12.png, alt: "Row function call in event list in ContentView.swift.")
                }
            }
        }
    }
    
    @Section(title: "Adding Toolbar Actions") {
        @ContentAndMedia {
            Implement toolbar actions to enable adding new events directly from the main interface.
            
            @Image(source: BAU-Section11.png, alt: "Main app interface with toolbar in the Checker app.")
        }
        
        @Steps {
            @Step {
                Apply a `.toolbar` modifier to the `Group`, adding a single `ToolbarItem` with `.primaryAction` placement.
                @Code(name: "ContentView.swift", file: "BAU-Section11-Step1.swift") {
                    @Image(source: BAU-Section11-Step1.png, alt: "Toolbar setup in ContentView.swift.")
                }
            }
            @Step {
                Inside the `ToolbarItem`, add a `Button` titled "Add Event" with the system image "plus", setting its action to `isPresentingEventCreateScreen.toggle()`.
                @Code(name: "ContentView.swift", file: "BAU-Section11-Step2.swift") {
                    @Image(source: BAU-Section11-Step2.png, alt: "Add Event button in toolbar in ContentView.swift.")
                }
            }
            @Step {
                Below the `.toolbar` modifier, add a `.sheet` modifier with `isPresented` bound to `$isPresentingEventCreateScreen` and `EventCreateView()` as its content.
                @Code(name: "ContentView.swift", file: "BAU-Section11-Step3.swift") {
                    @Image(source: BAU-Section11-Step3.png, alt: "Event creation sheet in ContentView.swift.")
                }
            }
        }
    }
}
